<UserControl x:Class="FixMate.App.Views.MonitoringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FixMate.App.Controls">
    <Grid Margin="38,34">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <DockPanel Margin="0,0,0,8">
                <Border Width="44" Height="44" CornerRadius="13" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Live monitoring" Margin="14,0,0,0" FontSize="30" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="Live system usage and activity, sampled while this page is open."
                       Margin="0,8,0,0"
                       FontSize="15"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
            <TextBlock Text="{Binding LastUpdatedText}"
                       Margin="0,12,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
            <TextBlock Text="{Binding ErrorMessage}"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap"
                       Foreground="#FFFF8A8A" />
            <WrapPanel Margin="0,14,0,0" VerticalAlignment="Center">
                <Button Content="{Binding PauseResumeLabel}" Command="{Binding PauseResumeCommand}" Padding="12,7" />
                <Button Content="Refresh now" Command="{Binding RefreshCommand}" Margin="7,0,0,0" Padding="12,7" />
                <Button Content="Clear graph history" Command="{Binding ClearHistoryCommand}" Margin="7,0,0,0" Padding="12,7" />
                <TextBlock Text="RANGE" Margin="18,0,7,0" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" />
                <ComboBox ItemsSource="{Binding RangeOptions}" SelectedItem="{Binding SelectedRangeMinutes}" MinWidth="110" VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding StringFormat={}{0} min}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </WrapPanel>
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="2" Margin="0,24,0,0">
            <Border Margin="0,0,8,8" Padding="18" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                <StackPanel>
                    <DockPanel><TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="CPU USAGE" FontSize="11" Foreground="{DynamicResource AccentBrush}" /></DockPanel>
                    <TextBlock Text="{Binding CpuValue}" Margin="0,8,0,0" FontSize="27" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CpuDetails}" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding CpuThresholdStatus}" Margin="0,4,0,0" FontSize="10" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Margin="8,0,0,8" Padding="18" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                <StackPanel>
                    <DockPanel><TextBlock Text="&#xE964;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="MEMORY USAGE" FontSize="11" Foreground="{DynamicResource AccentBrush}" /></DockPanel>
                    <TextBlock Text="{Binding MemoryValue}" Margin="0,8,0,0" FontSize="27" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding MemoryDetails}" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding MemoryThresholdStatus}" Margin="0,4,0,0" FontSize="10" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Margin="0,8,8,0" Padding="18" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                <StackPanel>
                    <DockPanel><TextBlock Text="&#xE964;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="DISK ACTIVITY" FontSize="11" Foreground="{DynamicResource AccentBrush}" /></DockPanel>
                    <TextBlock Margin="0,8,0,0" FontSize="14" FontWeight="SemiBold">
                        <Run Text="Read " /><Run Text="{Binding DiskReadValue, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0" FontSize="14" FontWeight="SemiBold">
                        <Run Text="Write " /><Run Text="{Binding DiskWriteValue, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding DiskDetails}" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Margin="8,8,0,0" Padding="18" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                <StackPanel>
                    <DockPanel><TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="NETWORK ACTIVITY" FontSize="11" Foreground="{DynamicResource AccentBrush}" /></DockPanel>
                    <TextBlock Margin="0,8,0,0" FontSize="14" FontWeight="SemiBold">
                        <Run Text="Receive " /><Run Text="{Binding NetworkReceiveValue, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0" FontSize="14" FontWeight="SemiBold">
                        <Run Text="Send " /><Run Text="{Binding NetworkSendValue, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding NetworkDetails}" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <TextBlock Grid.Row="2"
                   Text="Temperature sensors are not connected in this build."
                   Margin="0,14,0,0"
                   FontSize="12"
                   Foreground="{DynamicResource SecondaryTextBrush}" />

        <StackPanel Grid.Row="3" Margin="0,22,0,0">
            <TextBlock Text="Recent activity" FontSize="19" FontWeight="SemiBold" />
            <UniformGrid Columns="2" Margin="0,12,0,0">
                <Border Margin="0,0,8,8" Padding="16" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="CPU history" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding CpuStatistics}" Margin="0,3,0,0" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        <controls:LiveLineChart Values="{Binding CpuHistory}" MaximumValue="100" Stroke="{DynamicResource AccentBrush}" Height="105" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
                <Border Margin="8,0,0,8" Padding="16" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="Memory history" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding MemoryStatistics}" Margin="0,3,0,0" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        <controls:LiveLineChart Values="{Binding MemoryHistory}" MaximumValue="100" Stroke="{DynamicResource SuccessBrush}" Height="105" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
                <Border Margin="0,8,8,0" Padding="16" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="Disk read · bytes per second" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding DiskReadStatistics}" Margin="0,3,0,0" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        <controls:LiveLineChart Values="{Binding DiskReadHistory}" MaximumValue="104857600" Stroke="{DynamicResource AccentBrush}" Height="105" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
                <Border Margin="8,8,0,0" Padding="16" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="Disk write · bytes per second" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding DiskWriteStatistics}" Margin="0,3,0,0" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        <controls:LiveLineChart Values="{Binding DiskWriteHistory}" MaximumValue="104857600" Stroke="{DynamicResource SuccessBrush}" Height="105" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
                <Border Margin="8,8,0,0" Padding="16" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="Network receive · bytes per second" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding NetworkReceiveStatistics}" Margin="0,3,0,0" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        <controls:LiveLineChart Values="{Binding NetworkReceiveHistory}" MaximumValue="10485760" Stroke="{DynamicResource SuccessBrush}" Height="105" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
                <Border Margin="8,8,0,0" Padding="16" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="Network send · bytes per second" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding NetworkSendStatistics}" Margin="0,3,0,0" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        <controls:LiveLineChart Values="{Binding NetworkSendHistory}" MaximumValue="10485760" Stroke="{DynamicResource AccentBrush}" Height="105" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </Grid>
</UserControl>
