<UserControl x:Class="FixMate.App.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="34,30">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="OVERVIEW" Margin="7,0,0,0" FontSize="11" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding Heading}" Margin="0,7,0,0" FontSize="30" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Introduction}"
                               Margin="0,6,20,0"
                               FontSize="14"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Settings"
                            Command="{Binding DataContext.ShowSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Padding="14,8" />
                    <Button Content="System info"
                            Command="{Binding ShowSystemInformationCommand}"
                            Margin="8,0,0,0"
                            Padding="14,8" />
                </StackPanel>
            </Grid>

            <Border Margin="0,24,0,0"
                    Padding="18"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="Live system snapshot" FontSize="18" FontWeight="SemiBold" />
                        <Button DockPanel.Dock="Right"
                                Content="Open live monitor"
                                Command="{Binding ShowMonitoringCommand}"
                                Padding="12,6" />
                    </DockPanel>
                    <TextBlock Text="Current Windows readings. A brief snapshot is not a hardware fault test."
                               Margin="0,5,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap" />

                    <UniformGrid Columns="2" Margin="-6,14,-6,-6">
                        <Border Margin="6" Padding="16" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" DataContext="{Binding Monitoring}">
                            <StackPanel>
                                <DockPanel><TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="PROCESSOR" FontSize="11" Foreground="{DynamicResource AccentBrush}" /></DockPanel>
                                <TextBlock Text="{Binding CpuValue}" Margin="0,8,0,0" FontSize="30" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding CpuDetails}" Margin="0,5,0,0" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Margin="6" Padding="16" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" DataContext="{Binding Monitoring}">
                            <StackPanel>
                                <DockPanel><TextBlock Text="&#xE964;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="MEMORY" FontSize="11" Foreground="{DynamicResource AccentBrush}" /></DockPanel>
                                <TextBlock Text="{Binding MemoryValue}" Margin="0,8,0,0" FontSize="30" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding MemoryDetails}" Margin="0,5,0,0" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Margin="6" Padding="16" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" DataContext="{Binding Monitoring}">
                            <StackPanel>
                                <DockPanel><TextBlock Text="&#xE964;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="DISK ACTIVITY" FontSize="11" Foreground="{DynamicResource AccentBrush}" /></DockPanel>
                                <TextBlock Margin="0,8,0,0" FontSize="15" FontWeight="SemiBold">
                                    <Run Text="Read " /><Run Text="{Binding DiskReadValue, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Margin="0,3,0,0" FontSize="15" FontWeight="SemiBold">
                                    <Run Text="Write " /><Run Text="{Binding DiskWriteValue, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding DiskDetails}" Margin="0,5,0,0" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Margin="6" Padding="16" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" DataContext="{Binding Monitoring}">
                            <StackPanel>
                                <DockPanel><TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="NETWORK ACTIVITY" FontSize="11" Foreground="{DynamicResource AccentBrush}" /></DockPanel>
                                <TextBlock Margin="0,8,0,0" FontSize="15" FontWeight="SemiBold">
                                    <Run Text="Receive " /><Run Text="{Binding NetworkReceiveValue, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Margin="0,3,0,0" FontSize="15" FontWeight="SemiBold">
                                    <Run Text="Send " /><Run Text="{Binding NetworkSendValue, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding NetworkDetails}" Margin="0,5,0,0" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <TextBlock Text="{Binding Monitoring.LastUpdatedText}"
                               Margin="0,8,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Text="{Binding Monitoring.ErrorMessage}"
                               Margin="0,4,0,0"
                               Foreground="#FFFF8A8A"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Margin="0,18,0,0"
                    Padding="18"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                <StackPanel>
                    <TextBlock Text="STORAGE OVERVIEW" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="{Binding StorageSummary}"
                               Margin="0,8,0,0"
                               FontSize="15"
                               TextWrapping="Wrap" />
                    <ProgressBar Value="{Binding StorageUsedPercent, Mode=OneWay}"
                                 Maximum="100"
                                 Height="7"
                                 Margin="0,12,0,0"
                                 Background="{DynamicResource BorderBrush}"
                                 Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="{Binding StorageError}"
                               Margin="0,6,0,0"
                               Foreground="#FFFF8A8A"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Text="QUICK ACTIONS" Margin="0,22,0,0" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
            <UniformGrid Columns="2" Margin="-5,8,-5,0">
                <Button Margin="5" Padding="14" HorizontalContentAlignment="Stretch" Command="{Binding ShowDiagnosticsCommand}">
                    <DockPanel>
                        <TextBlock Text="›" DockPanel.Dock="Right" FontSize="22" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                        <StackPanel>
                            <TextBlock Text="Run diagnostics" FontWeight="SemiBold" />
                            <TextBlock Text="Review supported system checks" Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>
                    </DockPanel>
                </Button>
                <Button Margin="5" Padding="14" HorizontalContentAlignment="Stretch" Command="{Binding ShowMaintenanceCommand}">
                    <DockPanel>
                        <TextBlock Text="›" DockPanel.Dock="Right" FontSize="22" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                        <StackPanel>
                            <TextBlock Text="Analyze storage" FontWeight="SemiBold" />
                            <TextBlock Text="Review volumes and choose a folder to scan" Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </Button>
                <Button Margin="5" Padding="14" HorizontalContentAlignment="Stretch" Command="{Binding ShowTroubleshootingCommand}">
                    <DockPanel>
                        <TextBlock Text="›" DockPanel.Dock="Right" FontSize="22" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                        <StackPanel>
                            <TextBlock Text="Troubleshooting" FontWeight="SemiBold" />
                            <TextBlock Text="Follow guided steps for a symptom" Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>
                    </DockPanel>
                </Button>
                <Button Margin="5" Padding="14" HorizontalContentAlignment="Stretch" Command="{Binding ShowSystemInformationCommand}">
                    <DockPanel>
                        <TextBlock Text="›" DockPanel.Dock="Right" FontSize="22" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                        <StackPanel>
                            <TextBlock Text="Hardware information" FontWeight="SemiBold" />
                            <TextBlock Text="View details detected from this PC" Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>
                    </DockPanel>
                </Button>
            </UniformGrid>
        </StackPanel>
    </Grid>
</UserControl>
