<UserControl x:Class="FixMate.App.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FixMate.App.Controls">
    <Grid Margin="28,24">
        <StackPanel>
            <Border Padding="22,20"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="PC HEALTH OVERVIEW" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="{Binding Heading}" Margin="0,8,0,0" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Introduction}" Margin="0,5,20,0" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Button Content="View system details"
                                Command="{Binding ShowSystemInformationCommand}"
                                Background="{DynamicResource AccentBrush}"
                                BorderThickness="0"
                                Foreground="White"
                                Padding="14,9" />
                        <Button Content="Open live monitor"
                                Command="{Binding ShowMonitoringCommand}"
                                Margin="0,8,0,0"
                                Padding="14,8" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="SYSTEM SNAPSHOT" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                    <Border Margin="0,9,0,0" Padding="15" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                        <StackPanel>
                            <TextBlock Text="COMPUTER" FontSize="9" Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock Text="{Binding MachineName}" Margin="0,4,0,0" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding WindowsVersion}" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Margin="0,8,0,0" Padding="15" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                        <StackPanel>
                            <TextBlock Text="PROCESSOR" FontSize="9" Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock Text="{Binding ProcessorModel}" Margin="0,4,0,0" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="HARDWARE &amp; UPTIME" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                    <Border Margin="0,9,0,0" Padding="15" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                        <StackPanel>
                            <TextBlock Text="GRAPHICS" FontSize="9" Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock Text="{Binding GraphicsModel}" Margin="0,4,0,0" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="Installed memory" Margin="0,9,0,0" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock Text="{Binding InstalledMemory}" Margin="0,3,0,0" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Margin="0,8,0,0" Padding="15" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                        <StackPanel>
                            <TextBlock Text="SYSTEM UPTIME" FontSize="9" Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock Text="{Binding UptimeText}" Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
            <TextBlock Text="{Binding SystemInformationError}" Margin="0,6,0,0" FontSize="11" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" />

            <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="LIVE PERFORMANCE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="Current Windows-reported activity" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Monitoring.LastUpdatedText}" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
            </Grid>

            <UniformGrid Columns="2" Margin="-5,8,-5,0">
                <Border Margin="5" Padding="15" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="13" DataContext="{Binding Monitoring}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="CPU UTILIZATION" Margin="8,0,0,0" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                        </DockPanel>
                        <TextBlock Text="{Binding CpuValue}" Margin="0,8,0,0" FontSize="27" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CpuDetails}" Margin="0,2,0,0" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        <controls:LiveLineChart Values="{Binding CpuHistory}" MaximumValue="100" Stroke="{DynamicResource AccentBrush}" Height="50" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
                <Border Margin="5" Padding="15" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="13" DataContext="{Binding Monitoring}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="&#xE964;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource SuccessBrush}" />
                            <TextBlock Text="MEMORY UTILIZATION" Margin="8,0,0,0" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                        </DockPanel>
                        <TextBlock Text="{Binding MemoryValue}" Margin="0,8,0,0" FontSize="27" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding MemoryDetails}" Margin="0,2,0,0" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        <controls:LiveLineChart Values="{Binding MemoryHistory}" MaximumValue="100" Stroke="{DynamicResource SuccessBrush}" Height="50" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
                <Border Margin="5" Padding="15" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="13" DataContext="{Binding Monitoring}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="&#xE964;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="DISK ACTIVITY" Margin="8,0,0,0" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                        </DockPanel>
                        <TextBlock Margin="0,8,0,0" FontSize="13" FontWeight="SemiBold"><Run Text="Read  " /><Run Text="{Binding DiskReadValue, Mode=OneWay}" /></TextBlock>
                        <TextBlock Margin="0,3,0,0" FontSize="13" FontWeight="SemiBold"><Run Text="Write  " /><Run Text="{Binding DiskWriteValue, Mode=OneWay}" /></TextBlock>
                        <TextBlock Text="{Binding DiskDetails}" Margin="0,4,0,0" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        <controls:LiveLineChart Values="{Binding DiskReadHistory}" AutoScale="True" Stroke="{DynamicResource AccentBrush}" Height="50" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Margin="5" Padding="15" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="13" DataContext="{Binding Monitoring}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource WarningBrush}" />
                            <TextBlock Text="NETWORK ACTIVITY" Margin="8,0,0,0" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                        </DockPanel>
                        <TextBlock Margin="0,8,0,0" FontSize="13" FontWeight="SemiBold"><Run Text="Receive  " /><Run Text="{Binding NetworkReceiveValue, Mode=OneWay}" /></TextBlock>
                        <TextBlock Margin="0,3,0,0" FontSize="13" FontWeight="SemiBold"><Run Text="Send  " /><Run Text="{Binding NetworkSendValue, Mode=OneWay}" /></TextBlock>
                        <TextBlock Text="{Binding NetworkDetails}" Margin="0,4,0,0" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        <controls:LiveLineChart Values="{Binding NetworkReceiveHistory}" AutoScale="True" Stroke="{DynamicResource WarningBrush}" Height="50" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Margin="0,15,0,0" Padding="17" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="13">
                <StackPanel>
                    <DockPanel>
                        <StackPanel>
                            <TextBlock Text="STORAGE OVERVIEW" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="{Binding StorageSummary}" Margin="0,6,0,0" FontSize="13" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding StorageUsageText}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                    </DockPanel>
                    <ProgressBar Value="{Binding StorageUsedPercent, Mode=OneWay}" Maximum="100" Height="6" Margin="0,12,0,0" Background="{DynamicResource BorderBrush}" Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="{Binding StorageError}" Margin="0,5,0,0" FontSize="10" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Text="QUICK ACTIONS" Margin="0,22,0,0" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
            <UniformGrid Columns="2" Margin="-5,8,-5,0">
                <Button Margin="5" Padding="13" HorizontalContentAlignment="Stretch" Command="{Binding ShowDiagnosticsCommand}">
                    <DockPanel><TextBlock Text="&#xE9CE;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" /><StackPanel Margin="10,0,0,0"><TextBlock Text="Run diagnostics" FontWeight="SemiBold" /><TextBlock Text="Review supported system checks" Margin="0,3,0,0" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" /></StackPanel></DockPanel>
                </Button>
                <Button Margin="5" Padding="13" HorizontalContentAlignment="Stretch" Command="{Binding ShowMaintenanceCommand}">
                    <DockPanel><TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" /><StackPanel Margin="10,0,0,0"><TextBlock Text="Analyze storage" FontWeight="SemiBold" /><TextBlock Text="Review detected volumes" Margin="0,3,0,0" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" /></StackPanel></DockPanel>
                </Button>
            </UniformGrid>
        </StackPanel>
    </Grid>
</UserControl>
