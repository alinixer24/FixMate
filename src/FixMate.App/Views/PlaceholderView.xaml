<UserControl x:Class="FixMate.App.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="38,34">
        <StackPanel VerticalAlignment="Top">
            <TextBlock Text="FixMate" FontSize="13" Foreground="{DynamicResource AccentBrush}" />
            <TextBlock Text="{Binding Title}" Margin="0,8,0,0" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Description}"
                       Margin="0,12,0,0"
                       MaxWidth="700"
                       TextWrapping="Wrap"
                       FontSize="15"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
        </StackPanel>
    </Grid>
</UserControl>
