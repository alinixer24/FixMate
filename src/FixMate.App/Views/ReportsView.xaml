<UserControl x:Class="FixMate.App.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24">
            <Border Padding="20" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14">
                <StackPanel>
                    <TextBlock Text="REPORTS CENTER" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="Evidence-based PC reports" Margin="0,7,0,0" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock Text="Reports are collected on request from current Windows and FixMate data. Missing readings and tests that have not run are labelled explicitly." Margin="0,6,0,0" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Margin="0,12,0,0" Padding="18" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="13">
                <StackPanel>
                    <TextBlock Text="REPORT TYPE" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                    <ComboBox ItemsSource="{Binding AvailableReportTypes}" SelectedItem="{Binding SelectedReportType}" Margin="0,6,0,0" MaxWidth="360" HorizontalAlignment="Left" />
                    <TextBlock Text="INCLUDE SECTIONS" Margin="0,14,0,6" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                    <ItemsControl ItemsSource="{Binding ReportSections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsIncluded}" Margin="0,4,0,4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel Margin="0,14,0,0">
                        <Button Content="Preview latest data" Command="{Binding PreviewCommand}" IsEnabled="{Binding CanRun}" Padding="13,8" />
                        <Button Content="Export HTML" Command="{Binding ExportHtmlCommand}" IsEnabled="{Binding CanRun}" Margin="7,0,0,0" Padding="13,8" />
                        <Button Content="Export JSON" Command="{Binding ExportJsonCommand}" IsEnabled="{Binding CanRun}" Margin="7,0,0,0" Padding="13,8" />
                        <Button Content="Export CSV" Command="{Binding ExportCsvCommand}" IsEnabled="{Binding CanRun}" Margin="7,0,0,0" Padding="13,8" />
                        <Button Content="Print" Command="{Binding PrintCommand}" IsEnabled="{Binding CanRun}" Margin="7,0,0,0" Padding="13,8" />
                    </WrapPanel>
                    <TextBlock Text="PDF export is not included in this release. Printing uses the Windows print dialog." Margin="0,8,0,0" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Text="{Binding StatusMessage}" Margin="0,8,0,0" FontSize="11" Foreground="{DynamicResource SuccessBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ErrorMessage}" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <TextBlock Text="REPORT PREVIEW" Margin="0,18,0,7" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
            <TextBox Text="{Binding PreviewText, Mode=OneWay}" MinHeight="220" MaxHeight="430" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Background="{DynamicResource SurfaceBrush}" />
            <Grid Margin="0,18,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="LOCAL REPORT HISTORY" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Refresh history" Command="{Binding RefreshHistoryCommand}" IsEnabled="{Binding CanRun}" Padding="10,6" />
            </Grid>
            <ItemsControl ItemsSource="{Binding ReportHistory}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,5" Padding="9" Background="{DynamicResource SurfaceBrush}" CornerRadius="7">
                            <TextBlock Text="{Binding}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Reports remain in %LOCALAPPDATA%\FixMate\Reports. Maintenance history is unavailable because FixMate does not yet persist maintenance actions." Margin="0,7,0,0" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
