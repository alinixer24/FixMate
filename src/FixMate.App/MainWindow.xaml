<Window x:Class="FixMate.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FixMate.App.Views"
        xmlns:vm="clr-namespace:FixMate.App.ViewModels"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="FixMate"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        StateChanged="OnWindowStateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBackground" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Close" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="ButtonBackground" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="White" />
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate DataType="{x:Type vm:OverviewViewModel}">
            <views:OverviewView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SystemInformationViewModel}">
            <views:SystemInformationView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MonitoringViewModel}">
            <views:MonitoringView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DiagnosticsViewModel}">
            <views:DiagnosticsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TroubleshootingViewModel}">
            <views:TroubleshootingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ErrorCenterViewModel}">
            <views:ErrorCenterView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MaintenanceViewModel}">
            <views:MaintenanceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PageViewModel}">
            <views:PlaceholderView />
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource WindowBackgroundBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="FixMate" Margin="8,0,0,0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button Style="{StaticResource TitleBarButtonStyle}" ToolTip="Minimize" AutomationProperties.Name="Minimize" Click="OnMinimizeClick">
                        <Path Width="10" Height="1" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Data="M 0,0 L 10,0" />
                    </Button>
                    <Button x:Name="TitleBarMaximizeButton" Style="{StaticResource TitleBarButtonStyle}" ToolTip="Maximize" AutomationProperties.Name="Maximize" Click="OnMaximizeRestoreClick">
                        <Grid Width="12" Height="12">
                            <Path x:Name="MaximizeIcon" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Data="M 1,1 L 11,1 L 11,11 L 1,11 Z" />
                            <Path x:Name="RestoreIcon" Visibility="Collapsed" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Data="M 3,1 L 11,1 L 11,9 M 9,3 L 1,3 L 1,11 L 9,11 Z" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource TitleBarButtonStyle}" Tag="Close" ToolTip="Close" AutomationProperties.Name="Close" Click="OnCloseClick">
                        <Path Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Data="M 0,0 L 10,10 M 10,0 L 0,10" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="238" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}">
            <Grid Margin="18,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBlock Text="FixMate" FontSize="25" FontWeight="Bold" />
                    <TextBlock Text="PC health companion"
                               Margin="1,3,0,20"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <Button Style="{StaticResource NavigationButtonStyle}" Command="{Binding ShowOverviewCommand}" ToolTip="Overview">
                        <DockPanel><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" Width="24" VerticalAlignment="Center" /><TextBlock Text="Overview" VerticalAlignment="Center" /></DockPanel>
                    </Button>
                    <Button Style="{StaticResource NavigationButtonStyle}" Command="{Binding ShowSystemInformationCommand}" ToolTip="System information">
                        <DockPanel><TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets" Width="24" VerticalAlignment="Center" /><TextBlock Text="System information" VerticalAlignment="Center" /></DockPanel>
                    </Button>
                    <Button Style="{StaticResource NavigationButtonStyle}" Command="{Binding ShowMonitoringCommand}" ToolTip="Live monitoring">
                        <DockPanel><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Width="24" VerticalAlignment="Center" /><TextBlock Text="Live monitoring" VerticalAlignment="Center" /></DockPanel>
                    </Button>
                    <Button Style="{StaticResource NavigationButtonStyle}" Command="{Binding ShowDiagnosticsCommand}" ToolTip="Diagnostics">
                        <DockPanel><TextBlock Text="&#xE9CE;" FontFamily="Segoe MDL2 Assets" Width="24" VerticalAlignment="Center" /><TextBlock Text="Diagnostics" VerticalAlignment="Center" /></DockPanel>
                    </Button>
                    <Button Style="{StaticResource NavigationButtonStyle}" Command="{Binding ShowTroubleshootingCommand}" ToolTip="Troubleshooting">
                        <DockPanel><TextBlock Text="&#xE897;" FontFamily="Segoe MDL2 Assets" Width="24" VerticalAlignment="Center" /><TextBlock Text="Troubleshooting" VerticalAlignment="Center" /></DockPanel>
                    </Button>
                    <Button Style="{StaticResource NavigationButtonStyle}" Command="{Binding ShowErrorCenterCommand}" ToolTip="Error Center">
                        <DockPanel><TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" Width="24" VerticalAlignment="Center" /><TextBlock Text="Error Center" VerticalAlignment="Center" /></DockPanel>
                    </Button>
                    <Button Style="{StaticResource NavigationButtonStyle}" Command="{Binding ShowMaintenanceCommand}" ToolTip="Maintenance">
                        <DockPanel><TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" Width="24" VerticalAlignment="Center" /><TextBlock Text="Maintenance" VerticalAlignment="Center" /></DockPanel>
                    </Button>
                </StackPanel>
                <Button Grid.Row="2"
                        Style="{StaticResource NavigationButtonStyle}"
                        Command="{Binding ShowSettingsCommand}"
                        Margin="0,8,0,4"
                        ToolTip="Settings">
                    <DockPanel><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Width="24" VerticalAlignment="Center" /><TextBlock Text="Settings" VerticalAlignment="Center" /></DockPanel>
                </Button>
                <TextBlock Grid.Row="3"
                           Text="Local PC diagnostics"
                           Margin="1,8,0,0"
                           FontSize="11"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ContentControl Content="{Binding CurrentViewModel}" />
        </ScrollViewer>
        </Grid>
    </Grid>
</Window>
