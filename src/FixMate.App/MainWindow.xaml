<Window x:Class="FixMate.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FixMate.App.Views"
        xmlns:vm="clr-namespace:FixMate.App.ViewModels"
        Title="FixMate"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:OverviewViewModel}">
            <views:OverviewView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SystemInformationViewModel}">
            <views:SystemInformationView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MonitoringViewModel}">
            <views:MonitoringView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DiagnosticsViewModel}">
            <views:DiagnosticsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TroubleshootingViewModel}">
            <views:TroubleshootingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ErrorCenterViewModel}">
            <views:ErrorCenterView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MaintenanceViewModel}">
            <views:MaintenanceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PageViewModel}">
            <views:PlaceholderView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="238" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}">
            <DockPanel Margin="18,22">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="FixMate" FontSize="25" FontWeight="Bold" />
                    <TextBlock Text="PC health companion"
                               Margin="1,3,0,28"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}" />

                    <Button Content="Overview" Style="{StaticResource NavigationButtonStyle}" Command="{Binding ShowOverviewCommand}" />
                    <Button Content="System information" Style="{StaticResource NavigationButtonStyle}" Command="{Binding ShowSystemInformationCommand}" />
                    <Button Content="Live monitoring" Style="{StaticResource NavigationButtonStyle}" Command="{Binding ShowMonitoringCommand}" />
                    <Button Content="Diagnostics" Style="{StaticResource NavigationButtonStyle}" Command="{Binding ShowDiagnosticsCommand}" />
                    <Button Content="Troubleshooting" Style="{StaticResource NavigationButtonStyle}" Command="{Binding ShowTroubleshootingCommand}" />
                    <Button Content="Error Center" Style="{StaticResource NavigationButtonStyle}" Command="{Binding ShowErrorCenterCommand}" />
                    <Button Content="Maintenance" Style="{StaticResource NavigationButtonStyle}" Command="{Binding ShowMaintenanceCommand}" />
                    <Button Content="Settings" Style="{StaticResource NavigationButtonStyle}" Command="{Binding ShowSettingsCommand}" />
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom"
                           Text="Foundation build"
                           Margin="1,18,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <ContentControl Content="{Binding CurrentViewModel}" />
        </ScrollViewer>
    </Grid>
</Window>
